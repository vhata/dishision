#!/usr/bin/env bash
# Pre-commit: queue, link, format and lint checks on the staged copies of the
# files. Typecheck and tests run on push.
# Bypass (--no-verify) is for a broken toolchain only; say so in the PR.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# Validate the staged content, not the working tree: extract the index copies.
if printf '%s\n' "$staged" | grep -Eq '^(TODO\.md|review/BACKLOG\.md)$'; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  args=""
  if git cat-file -e :TODO.md 2>/dev/null; then
    git show :TODO.md > "$tmp/TODO.md"; args="$args --todo $tmp/TODO.md"
  fi
  if git cat-file -e :review/BACKLOG.md 2>/dev/null; then
    git show :review/BACKLOG.md > "$tmp/BACKLOG.md"; args="$args --backlog $tmp/BACKLOG.md"
  fi
  # shellcheck disable=SC2086
  bash docket/scripts/check-queues.sh --strict $args
fi
if printf '%s\n' "$staged" | grep -Eq '\.md$'; then
  bash docket/scripts/check-links.sh
fi

# Format and lint the staged copies with Biome. biome.json and package.json come
# from the index too: Biome enables its React and test rules from package.json.
biome_tmp="$(mktemp -d)"
trap 'rm -rf "${tmp:-}" "$biome_tmp"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR -- \
  '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs' '*.json' '*.jsonc' '*.css' ':(exclude)docket/**' > "$biome_tmp/.staged"
if [ -s "$biome_tmp/.staged" ]; then
  biome="$PWD/node_modules/.bin/biome"
  [ -x "$biome" ] || { echo "pre-commit: Biome is not installed; run 'bash scripts/setup.sh'" >&2; exit 1; }
  { printf 'biome.json\0package.json\0'; cat "$biome_tmp/.staged"; } | git checkout-index -f -z --stdin --prefix="$biome_tmp/"
  (cd "$biome_tmp" && xargs -0 "$biome" check --vcs-enabled=false --error-on-warnings --no-errors-on-unmatched < .staged) || {
    echo "pre-commit: Biome found problems in the staged files; 'pnpm fmt' fixes formatting and import order, 'pnpm lint' lists the rest" >&2
    exit 1
  }
fi
