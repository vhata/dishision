#!/usr/bin/env bash
# Pre-commit: queue, link, format and lint checks on the staged copies of the
# files. Typecheck and tests run on push.
# Bypass (--no-verify) is for a broken toolchain only; say so in the PR.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# Validate the staged content, not the working tree: extract the index copies.
if printf '%s\n' "$staged" | grep -Eq '^(TODO\.md|review/BACKLOG\.md)$'; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  args=""
  if git cat-file -e :TODO.md 2>/dev/null; then
    git show :TODO.md > "$tmp/TODO.md"; args="$args --todo $tmp/TODO.md"
  fi
  if git cat-file -e :review/BACKLOG.md 2>/dev/null; then
    git show :review/BACKLOG.md > "$tmp/BACKLOG.md"; args="$args --backlog $tmp/BACKLOG.md"
  fi
  # shellcheck disable=SC2086
  bash docket/scripts/check-queues.sh --strict $args
fi
if printf '%s\n' "$staged" | grep -Eq '\.md$'; then
  bash docket/scripts/check-links.sh
fi

# Format and lint the staged copies with Biome, using the staged biome.json.
code="$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json|jsonc|css)$' | grep -v '^docket/' || true)"
if [ -n "$code" ]; then
  biome_tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}" "$biome_tmp"' EXIT
  { echo biome.json; printf '%s\n' "$code"; } | sort -u | git checkout-index --stdin --prefix="$biome_tmp/"
  biome="$PWD/node_modules/.bin/biome"
  # shellcheck disable=SC2086
  (cd "$biome_tmp" && "$biome" check --vcs-enabled=false --error-on-warnings --no-errors-on-unmatched $code) || {
    echo "pre-commit: Biome found problems in the staged files; run 'pnpm fmt' and restage" >&2
    exit 1
  }
fi
