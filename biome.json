{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!docket", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["kb/**/*.json", "fixtures/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/worker", "**/worker/**", "**/client", "**/client/**", "**/providers", "**/providers/**"],
                    "message": "src/core imports nothing from src/worker, src/client or src/providers (ARCHITECTURE.md invariants)."
                  },
                  {
                    "group": [":PACKAGE:", ":NODE:", ":BUN:", "*:*", "!zod", "!zod/**"],
                    "message": "src/core may import only zod and its own modules, so it stays free of Worker, DOM, React and provider code and runs under plain node. Extend the allowlist in biome.json only for a pure, runtime-neutral package."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
